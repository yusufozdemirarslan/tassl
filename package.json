{
  "name": "tassl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "evals": "tsx evals/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx scripts/pgboss-migrate.ts",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:studio": "drizzle-kit studio",
    "jobs:worker": "tsx scripts/jobs-worker.ts",
    "jobs:retry": "tsx scripts/jobs-retry.ts",
    "openapi:generate": "tsx --conditions=react-server scripts/openapi-generate.ts",
    "openapi:check": "tsx --conditions=react-server scripts/openapi-generate.ts --check",
    "docs:build": "bash scripts/docs-build.sh",
    "email:dev": "email dev --dir src/server/email/templates --port 3001",
    "lhci": "lhci autorun",
    "smoke": "bash scripts/smoke.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@hookform/resolvers": "5.9.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "pg-boss": "12.29.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "resend": "6.25.0",
    "server-only": "0.0.1",
    "shadcn": "4.20.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "zod": "4.5.4",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@faker-js/faker": "10.6.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "msw": "2.15.0",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.9.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  }
}
